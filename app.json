{
  "expo": {
    "name": "Spotify Queue Shuffler",
    "slug": "spotify-queue-shuffler",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": [
      "spotifyqueue",
      "spotify-queue-login"
    ],
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
